# Base URL for the existing Jinni partner dashboard deployment.
# Set this in Vercel only after the dashboard app has been deployed.
VITE_PARTNER_PORTAL_URL=https://partners.jinniwishes.in
# Public Jinni backend origin used by the PIN-code availability checker.
# Set this to the actual deployed FastAPI API origin (no /api/v1 and no trailing slash).
# Example format only: https://api.your-domain.in
VITE_API_URL=
